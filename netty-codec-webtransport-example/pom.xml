<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.suboptimal-solutions</groupId>
        <artifactId>netty-codec-webtransport-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>netty-codec-webtransport-example</artifactId>
    <packaging>jar</packaging>

    <name>netty-codec-webtransport-example</name>
    <description>Runnable WebTransport demos.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>netty-codec-webtransport</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-native-quic</artifactId>
            <classifier>${os.detected.classifier}</classifier>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Convenience runner. From the repo root:
                    mvn -B -pl netty-codec-webtransport-example -am exec:java
                Then open http://localhost:8080/ in Chrome and click "Connect".
                Override ports with -DWT_PORT=9000 -DHTTP_PORT=9001.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>io.suboptimal.netty.webtransport.example.EchoServer</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
