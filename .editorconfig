root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.java]
# Google Java Format wraps at 100; keep .editorconfig in lockstep so
# IDE-formatted lines don't get rewritten by Spotless.
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{xml,yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab

[specs/*.{txt,html}]
trim_trailing_whitespace = false
insert_final_newline = false
max_line_length = off
